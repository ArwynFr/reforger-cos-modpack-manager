@page "/modpack"
@using ArwynFr.Reforger.ModpackMgr.Components.Components
@using ArwynFr.Reforger.ModpackMgr.Database
@using ArwynFr.Reforger.ModpackMgr.Domain
@using ArwynFr.Reforger.ModpackMgr.Workshop
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization

@rendermode InteractiveServer
@attribute [Authorize]

@inject IDbContextFactory<ModsDbContext> DbContextFactory
@inject WorkshopItemRepository WorkshopItemRepository
@inject ILogger<Modpack> Logger


<PageTitle>Modpack</PageTitle>

<h1>Modpack</h1>

<div class="row">
    <div class="card dashboard-card border-secondary rounded-3 h-100 m-3 col-2">
        <div class="card-body d-flex align-items-center gap-3">
            <div class="d-flex align-items-center justify-content-center
                bg-dark bg-opacity-25 rounded-3 flex-shrink-0" style="width: 52px; height: 52px;">
                📦
            </div>
            <div class="">
                <div class="fs-4 fw-bold lh-1">@mods.Count</div>
                <div class="">-</div>
                <small class="text-muted">mods au total</small>
            </div>
        </div>
    </div>
    <div class="card dashboard-card border-secondary rounded-3 h-100 m-3 col-2">
        <div class="card-body d-flex align-items-center gap-3">
            <div class="d-flex align-items-center justify-content-center
                bg-dark bg-opacity-25 rounded-3 flex-shrink-0" style="width: 52px; height: 52px;">
                🧩
            </div>
            <div class="">
                <div class="fs-4 fw-bold lh-1">@mods.Count(_=>_.Enabled)</div>
                <div class="">-</div>
                <small class="text-muted">mods actifs</small>
            </div>
        </div>
    </div>
    <div class="card dashboard-card border-secondary rounded-3 h-100 m-3 col-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold">Quota</span>
                <span class="">@(ModpackPercent)% utilisé</span>
            </div>
            <div class="progress mb-2" style="height: 10px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @ModpackPercent%;"
                     aria-valuenow="@ModpackPercent" aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>

            <small class="text-muted">@ModpackSize / 25 Go</small>
        </div>
    </div>
</div>

<Search ResultSelected="Ajouter" />

<div class="d-grid m-3">
    @if (updating)
    {
        <button type="button" class="btn btn-primary py-3 fw-semibold" @onclick="FetchAllWorshopInfo" disabled="@updating">
            <span class="spinner-border" role="status"></span>
        </button>
    }
    else
    {
        <button type="button" class="btn btn-primary py-3 fw-semibold" @onclick="FetchAllWorshopInfo" disabled="@updating">
            <span>🗘 Synchroniser avec le Workshop</span>
        </button>
    }
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th class="col-2">Mod</th>
            <th class="col-1">Category</th>
            <th class="col-1">Version</th>
            <th class="col-1">Game</th>
            <th class="col-1">Size</th>
            <th class="col-1">Enabled</th>
            <th class="col-1">Dependencies</th>
            <th class="col-1">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mod in mods)
        {
            <ModItem @key="mod.Id" entity="@mod" Supprimer="Supprimer" OnDragStart="StartDrag" OnDrop="DropMod"
                     OnTop="Top" />
        }
    </tbody>
</table>

    

@code {

    private List<Mod> mods = [];

    private bool updating = false;

    private long? totalSize => mods.Where(_ => _.Enabled).Sum(_ => _.Size);

    public string FormatSize(long? value) => value is null ? "- Go" : $"{Math.Round(value / 1073741824m ?? 0, 1,
MidpointRounding.AwayFromZero)} Go";

    public string ModpackSize => FormatSize(totalSize);

    public string ModpackPercent => Math.Ceiling(Decimal.Divide(totalSize.Value, 26_843_545_600) * 100).ToString();

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbContextFactory.CreateDbContextAsync(CancellationToken.None);
        this.mods = await context.Mods.AsNoTrackingWithIdentityResolution()
            .Include(_ => _.Dependants)
            .Include(_ => _.Dependencies)
            .OrderBy(_ => _.Order)
            .ToListAsync(CancellationToken.None);
    }

    private async Task Supprimer(string id)
    {
        using var context = await DbContextFactory.CreateDbContextAsync(CancellationToken.None);
        await context.Mods.Where(_ => _.Id == id).ExecuteDeleteAsync(CancellationToken.None);
        await OnInitializedAsync();
        StateHasChanged();
    }

    private async Task Ajouter(string id)
    {
        if (mods.Any(_ => _.Id == id)) { return; }
        using var context = await DbContextFactory.CreateDbContextAsync(CancellationToken.None);
        context.Mods.AttachRange(mods);
        var entity = context.Mods.Add(new(id) { Enabled = true, Order = -1 }).Entity;
        await entity.FetchWorkshopInformation(context.Mods, WorkshopItemRepository, CancellationToken.None);
        await context.SaveChangesAsync();
        await Reorder();
        StateHasChanged();
    }

    private async Task FetchAllWorshopInfo(MouseEventArgs args)
    {
        updating = true;
        StateHasChanged();
        WorkshopItemRepository.Clear();
        using var context = await DbContextFactory.CreateDbContextAsync(CancellationToken.None);
        context.Mods.AttachRange(mods);
        foreach (var mod in mods)
        {
            await mod.FetchWorkshopInformation(context.Mods, WorkshopItemRepository, CancellationToken.None);
            await context.SaveChangesAsync(CancellationToken.None);
        }

        await Reorder();
        updating = false;
        StateHasChanged();
    }

    private Mod? dragSource;

    private void StartDrag(Mod source)
    {
        this.dragSource = source;
    }

    private async Task DropMod(Mod target)
    {
        if (dragSource is not Mod source) { return; }
        var target_index = mods.IndexOf(target);
        mods.Remove(source);
        mods.Insert(target_index, source);
        await Reorder();
    }

    private async Task Reorder()
    {
        using var context = await DbContextFactory.CreateDbContextAsync(CancellationToken.None);
        context.Mods.AttachRange(mods);
        foreach (var mod in mods)
        {
            mod.Order = mods.IndexOf(mod);
        }

        await context.SaveChangesAsync(CancellationToken.None);
        await OnInitializedAsync();
        StateHasChanged();
    }

    private async Task Top(Mod mod)
    {
        mods.Remove(mod);
        mods.Insert(0, mod);
        await Reorder();
    }
}