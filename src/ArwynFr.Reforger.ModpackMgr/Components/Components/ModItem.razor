@using ArwynFr.Reforger.ModpackMgr.Database
@using ArwynFr.Reforger.ModpackMgr.Domain
@using ArwynFr.Reforger.ModpackMgr.Workshop
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Design

@inject IDbContextFactory<ModsDbContext> DbContextFactory
@inject WorkshopItemRepository WorkshopItemRepository

<tr draggable="true" @ondragstart="DragStart" @ondragover:preventDefault @ondrop="Drop">
    <td @onclick="ToggleDependencies">
        <input type="button" class="btn mx-1" value="⬆️" @onclick="async () => await OnTop.InvokeAsync(entity)" />
        @if (missingDependencies.Any())
        {
            <input type="button" class="btn btn-sm btn-primary mx-3" value="+"
                   @onclick="() => AjouterDependances.InvokeAsync(missingDependencies)" />
        }
        @if (entity.Dependants.Any())
        {
            <span title="Ce mod est une dépendance" class="badge rounded-pill bg-success-subtle border">🔗</span>
        }
        else
        {
            <span title="Ce mod n'est pas une dépendance" class="badge rounded-pill bg-light text-muted border">🔗</span>
        }
        @if (entity.Dependencies.Any())
        {
            <span title="Ce mod dépend d'un autre mod" class="badge rounded-pill bg-success-subtle border">🔒</span>
        }
        else
        {
            <span title="Ce mod ne dépend d'aucun mod" class="badge rounded-pill bg-light text-muted border">🔒</span>
        }
        @if (entity.Dependencies.Any(_ => _.Order > entity.Order))
        {
            <span title="Attention ce mod est trié avant ses dépenances">⚠️</span>
        }
    </td>
    <td>
        @entity.Id
    </td>
    <td>
        @entity.Name
    </td>
    <td @onclick="StartEditing" style="cursor: pointer;">
        @if (isEditing)
        {
            <input class="form-control" @bind:get="entity.Category" @bind:set="SetCategory" @onblur="OnBlur"
                   @onkeyup="OnKeyUp" />
        }
        else
        {
            @entity.Category
        }
    </td>
    <td @onclick="StartEditing" style="cursor: pointer;">
        @if (isEditing)
        {
            <input class="form-control" @bind:get="entity.Version" @bind:set="SetVersion" @onblur="OnBlur"
                   @onkeyup="OnKeyUp" />
        }
        else if (entity.Version is not "")
        {
            <span class="badge text-bg-warning">@entity.Version</span>
        }
        else if (entity.EffectiveVersion is not "")
        {
            <span>@entity.EffectiveVersion</span>
        }
        else
        {
            <span class="fst-italic">latest</span>
        }
    </td>
    <td>
        @if (entity.GameVersion is not null)
        {
            <span class="badge @BadgeClass">
                @entity.GameVersion.ToString(2)
            </span>
        }
    </td>
    <td class="text-end">
        @if (entity.Size is not null)
        {
            <span>
                @(entity.Size / 1048576) Mo
            </span>
        }
        else
        {
            <span>-</span>
        }
    </td>
    <td>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" checked="@entity.Enabled" id="enabled" @oninput="SetEnabled"
                   switch>
            @if (entity is { Enabled: false } && entity.Dependants.Any(_ => _.Enabled))
            {
                <span title="Attention ce mod sera quand même inclus à cause de : @enabledDependants">⚠️</span>
            }
        </div>
    </td>
    <td>
        <button class=" btn btn-sm btn-danger" @onclick="() => Supprimer.InvokeAsync(entity.Id)">
            Supprimer
        </button>
    </td>
</tr>
@if (showDependencies)
{
    <tr>
        <td colspan="7">
            <p>Dependencies: @dependencies</p>
            <p>Dependants: @dependants</p>
        </td>
    </tr>
}

@code {
    public bool showDependencies = false;
    public bool isEditing = false;
    public bool isForced = false;
    private bool isDependency = false;
    public string[] missingDependencies = [];
    public string dependencies = string.Empty;
    public string dependants = string.Empty;
    public string enabledDependants = string.Empty;


    private string RowClass => missingDependencies is { Length: > 0 } ? "text-danger" : string.Empty;
    [Parameter] public required Mod entity { get; set; }
    [Parameter] public EventCallback<string> Supprimer { get; set; }
    [Parameter] public EventCallback<string[]> AjouterDependances { get; set; }
    [Parameter] public EventCallback<Mod> OnDragStart { get; set; }
    [Parameter] public EventCallback<Mod> OnDrop { get; set; }
    [Parameter] public EventCallback<Mod> OnTop { get; set; }

    private string BadgeClass => entity.GameVersion switch
    {
        { Major: > 1 } => "text-bg-success",
        { Major: 1, Minor: >= 8 } => "text-bg-success",
        _ => "text-bg-warning"
    };

    public async Task SetCategory(string value)
    {
        using var context = await DbContextFactory.CreateDbContextAsync(CancellationToken.None);
        context.Mods.Attach(entity);
        entity.Category = value;
        await context.SaveChangesAsync(CancellationToken.None);
    }

    public async Task SetVersion(string value)
    {
        using var context = await DbContextFactory.CreateDbContextAsync(CancellationToken.None);
        context.Mods.Attach(entity);
        entity.Version = value;
        await context.SaveChangesAsync(CancellationToken.None);
    }

    private async Task SetEnabled(ChangeEventArgs args)
    {

        using var context = await DbContextFactory.CreateDbContextAsync(CancellationToken.None);
        context.Mods.Attach(entity);
        entity.Enabled = args.Value switch { bool value => value, _ => default };
        await context.SaveChangesAsync(CancellationToken.None);
    }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbContextFactory.CreateDbContextAsync(CancellationToken.None);
        @* this.entity = await context.Mods
            .Include(_ => _.Dependencies)
            .Include(_ => _.Dependants)
            .Where(_ => _.Id == ModId)
            .FirstOrDefaultAsync() ?? throw new InvalidOperationException(); *@

        dependants = string.Join(", ", entity.Dependants.Select(_ => _.Name));
        dependencies = string.Join(", ", entity.Dependencies.Select(_ => _.Name));
        enabledDependants = string.Join(", ", entity.Dependants.Where(_ => _.Enabled).Select(_ => _.Name));
        missingDependencies = entity.Dependencies.Where(_ => _.Name == "").Select(_ => _.Id).ToArray();
    }

    public void StartEditing() => isEditing = true;

    public void OnBlur() => isEditing = false;

    public void OnKeyUp(KeyboardEventArgs keyboardEventArgs)
    {
        if (keyboardEventArgs is { Key: "Escape" or "Enter" })
        {
            isEditing = false;
        }
    }

    private void ToggleDependencies()
    {
        showDependencies = !showDependencies;
        StateHasChanged();
    }

    private async Task DragStart()
    {
        await OnDragStart.InvokeAsync(entity);
    }
    private async Task Drop()
    {
        await OnDrop.InvokeAsync(entity);
    }
}